# ──────────────────────────────────────────────
# SCALE PROTOCOL — Environment Variables
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scaleprotocol?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Solana
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Base58 secret key (or solana-keygen JSON array) for the protocol pool wallet
PROTOCOL_WALLET_PRIVATE_KEY="your-base58-solana-secret-key"
# Public address of the pool wallet (used by scanners/routes that only read)
PROTOCOL_WALLET="your-protocol-wallet-address"
# $SCALE SPL token mint (from the pump.fun launch)
SCALE_TOKEN_MINT="your-scale-token-mint"
# Wallets whose $SCALE holdings count as locked supply (comma-separated)
SCALE_LOCKED_WALLETS=""
# Extra token mints always allowed to list, bypassing pump.fun verification (comma-separated)
SCALE_VERIFIED_TOKENS=""
# Jupiter API — defaults to the free lite tier; set both for the paid tier
JUPITER_API_URL=""
JUPITER_API_KEY=""
# Paid CoinGecko API key — flips market data to pro-api.coingecko.com (~500 req/min)
COINGECKO_API_KEY=""

# Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# API
API_PORT=4001
API_URL="http://localhost:4001"
JWT_SECRET="your-jwt-secret-change-in-production"

# Sybil resistance
SIGNUP_MAX_PER_DEVICE=1
SIGNUP_MAX_PER_IP=3

# Frontend
VITE_API_URL="http://localhost:4001"

# Protocol Config
FLAT_FEE_BONDED=200
FLAT_FEE_RISING=300
FLAT_FEE_DEGEN=500
CREATOR_REVENUE_SHARE=3000
BURN_REVENUE_SHARE=2000
POOL_REVENUE_SHARE=5000
USER_PROFIT_LOCK_BPS=3000
# Burn batch threshold in lamports (0.5 SOL)
BURN_THRESHOLD_LAMPORTS=500000000

# Insurance Fund
INSURANCE_FUND_TARGET_BPS=200
INSURANCE_DEPOSIT_RATE_BPS=1000

# Encryption (for custodial wallets) — 32-byte hex
ENCRYPTION_KEY="your-32-byte-hex-encryption-key"
