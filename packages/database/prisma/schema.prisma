generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Users — custodial email/password accounts
// ──────────────────────────────────────────────
model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.Text
  walletAddress  String   @unique @map("wallet_address") @db.VarChar(42)
  encryptedKey   String   @map("encrypted_key") @db.Text
  legacyWalletAddress String? @map("legacy_wallet_address") @db.VarChar(42) // superseded wallet, kept so the old key stays recoverable
  legacyEncryptedKey  String? @map("legacy_encrypted_key") @db.Text
  registrationIp String?  @map("registration_ip") @db.VarChar(64)  // sybil resistance
  deviceId       String?  @map("device_id") @db.VarChar(64)         // sybil resistance
  referralCode   String?  @unique @map("referral_code") @db.VarChar(12)
  referredById   Int?     @map("referred_by_id")
  referredBy     User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]   @relation("Referrals")
  // Twitter OAuth fields
  twitterHandle      String?  @map("twitter_handle") @db.VarChar(50)
  twitterVerified    Boolean  @default(false) @map("twitter_verified")
  twitterAccessToken String?  @map("twitter_access_token") @db.Text
  twitterRefreshToken String? @map("twitter_refresh_token") @db.Text
  twitterTokenExpiry DateTime? @map("twitter_token_expiry")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([registrationIp])
  @@index([deviceId])
  @@index([referredById])
  @@index([twitterHandle])
  @@map("users")
}

// ──────────────────────────────────────────────
// Points — pre-token flywheel. Earned from REAL position volume only
// (100 pts / 1 ETH notional) plus a 20% referral override. Never from
// posting or social actions.
// ──────────────────────────────────────────────
model PointsLedger {
  id            Int      @id @default(autoincrement())
  userWallet    String   @map("user_wallet") @db.VarChar(42)
  type          String   @db.VarChar(20) // 'trade_volume' | 'referral_bonus'
  points        BigInt
  positionId    Int?     @map("position_id")
  refereeWallet String?  @map("referee_wallet") @db.VarChar(42) // set on referral_bonus rows
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userWallet])
  @@index([type])
  @@index([createdAt])
  @@map("points_ledger")
}

// ──────────────────────────────────────────────
// Listed tokens — auto-discovered when creator redirects fees
// ──────────────────────────────────────────────
model Token {
  id                  Int       @id @default(autoincrement())
  address             String    @unique @db.VarChar(42)
  name                String?   @db.VarChar(100)
  symbol              String?   @db.VarChar(20)
  imageUri            String?   @map("image_uri") @db.Text
  creatorWallet       String    @map("creator_wallet") @db.VarChar(42)
  tier                String    @db.VarChar(10) // 'bonded', 'rising', 'degen'
  feeWalletPda        String?   @map("fee_wallet_pda") @db.VarChar(42)
  listedAt            DateTime  @default(now()) @map("listed_at")
  isActive            Boolean   @default(true) @map("is_active")
  isAutoListed        Boolean   @default(false) @map("is_auto_listed")
  totalFeesClaimed    BigInt    @default(0) @map("total_fees_claimed")
  totalTradingVolume  BigInt    @default(0) @map("total_trading_volume")
  totalCreatorPayouts BigInt    @default(0) @map("total_creator_payouts")

  positions      Position[]
  feeClaims      FeeClaim[]
  creatorPayouts CreatorPayout[]

  @@map("tokens")
}

// ──────────────────────────────────────────────
// Leveraged positions
// ──────────────────────────────────────────────
model Position {
  id               Int       @id @default(autoincrement())
  userWallet       String    @map("user_wallet") @db.VarChar(42)
  tokenId          Int       @map("token_id")
  status           String    @db.VarChar(20) // 'opening', 'open', 'closing', 'closed_profit', 'closed_loss', 'liquidated', 'timed_out', 'failed'
  userCapital      BigInt    @map("user_capital")      // wei
  protocolCapital  BigInt    @map("protocol_capital")  // wei
  leverage         Decimal   @db.Decimal(4, 2)
  flatFee          BigInt    @map("flat_fee")          // wei
  tier             String    @db.VarChar(10)
  entryPrice       Decimal?  @map("entry_price") @db.Decimal(20, 10)
  exitPrice        Decimal?  @map("exit_price") @db.Decimal(20, 10)
  tokensBought     BigInt?   @map("tokens_bought")
  exitThreshold    Decimal   @map("exit_threshold") @db.Decimal(5, 2)
  takeProfitPct    Decimal?  @map("take_profit_pct") @db.Decimal(7, 2) // price move % to auto-take-profit
  stopLossPct      Decimal?  @map("stop_loss_pct") @db.Decimal(5, 2)   // price move % to auto-stop-loss
  slippageRisk     Int?      @map("slippage_risk")     // 0-100 risk score
  pnlEth           BigInt?   @map("pnl_eth")          // wei (positive = profit)
  userProfit       BigInt?   @map("user_profit")       // user's 70% cash + 30% locked
  protocolRevenue  BigInt?   @map("protocol_revenue")  // flat fee only
  creatorPayout    BigInt?   @map("creator_payout")     // 30% of flat fee
  burnAmount       BigInt?   @map("burn_amount")        // 20% of flat fee
  poolReturn       BigInt?   @map("pool_return")        // 50% of flat fee
  lockAmount       BigInt?   @map("lock_amount")        // 30% of profit → buy $FRONT
  openedAt         DateTime  @default(now()) @map("opened_at")
  closedAt         DateTime? @map("closed_at")
  closeTx          String?   @map("close_tx") @db.VarChar(66)
  openTx           String?   @map("open_tx") @db.VarChar(66)
  // Recovery markers: each irreversible on-chain step records its tx hash the
  // moment it lands, so a crash at ANY point leaves enough state for the
  // reconciliation sweep to finish (or refund) the position instead of
  // stranding funds. statusChangedAt bounds how long a transient state
  // ('opening'/'closing') may live before the sweep intervenes.
  collateralTx     String?   @map("collateral_tx") @db.VarChar(66)
  userReturnTx     String?   @map("user_return_tx") @db.VarChar(66)
  ethReceived      BigInt?   @map("eth_received")   // wei from the close sell
  statusChangedAt  DateTime  @default(now()) @map("status_changed_at")

  token          Token          @relation(fields: [tokenId], references: [id])
  burns          Burn[]
  profitLocks    ProfitLock[]
  creatorPayouts CreatorPayout[]

  @@index([userWallet])
  @@index([tokenId])
  @@index([status])
  @@map("positions")
}

// ──────────────────────────────────────────────
// $FRONT token burns
// ──────────────────────────────────────────────
model Burn {
  id          Int      @id @default(autoincrement())
  ethAmount   BigInt   @map("eth_amount")   // wei spent
  tokenAmount BigInt   @map("token_amount") // $FRONT burned (raw units)
  txHash String   @map("tx_hash") @db.VarChar(66)
  positionId  Int?     @map("position_id")
  burnedAt    DateTime @default(now()) @map("burned_at")

  position Position? @relation(fields: [positionId], references: [id])

  @@map("burns")
}

// ──────────────────────────────────────────────
// Profit locks — $FRONT locked for 7 days
// ──────────────────────────────────────────────
model ProfitLock {
  id          Int       @id @default(autoincrement())
  userWallet  String    @map("user_wallet") @db.VarChar(42)
  ethAmount   BigInt    @map("eth_amount")                 // wei
  tokenAmount BigInt    @map("token_amount") // $FRONT locked (raw units)
  positionId  Int?      @map("position_id")
  buyTx       String    @map("buy_tx") @db.VarChar(66)
  lockTx      String?   @map("lock_tx") @db.VarChar(66)
  unlockTx    String?   @map("unlock_tx") @db.VarChar(66)
  claimTx     String?   @map("claim_tx") @db.VarChar(66)
  lockedAt    DateTime  @default(now()) @map("locked_at")
  unlocksAt   DateTime  @map("unlocks_at")  // lockedAt + 7 days
  isUnlocked  Boolean   @default(false) @map("is_unlocked")
  isClaimed   Boolean   @default(false) @map("is_claimed")

  position Position? @relation(fields: [positionId], references: [id])

  @@index([userWallet])
  @@index([isUnlocked, unlocksAt])
  @@index([isClaimed])
  @@map("profit_locks")
}

// ──────────────────────────────────────────────
// Creator payouts — 30% of flat fee revenue share
// ──────────────────────────────────────────────
model CreatorPayout {
  id            Int       @id @default(autoincrement())
  tokenId       Int       @map("token_id")
  creatorWallet String    @map("creator_wallet") @db.VarChar(42)
  amount        BigInt                            // wei
  positionId    Int?      @map("position_id")
  status        String    @db.VarChar(20)         // 'pending', 'claimable', 'claimed'
  claimTx       String?   @map("claim_tx") @db.VarChar(66)
  createdAt     DateTime  @default(now()) @map("created_at")
  claimedAt     DateTime? @map("claimed_at")

  token    Token     @relation(fields: [tokenId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  @@index([creatorWallet, status])
  @@index([tokenId])
  @@map("creator_payouts")
}

// ──────────────────────────────────────────────
// Fee claims from PONS
// ──────────────────────────────────────────────
model FeeClaim {
  id          Int      @id @default(autoincrement())
  tokenId     Int      @map("token_id")
  amount      BigInt                            // wei
  txHash String   @map("tx_hash") @db.VarChar(66)
  claimedAt   DateTime @default(now()) @map("claimed_at")

  token Token @relation(fields: [tokenId], references: [id])

  @@map("fee_claims")
}

// ──────────────────────────────────────────────
// Telegram bot users — generated wallets
// ──────────────────────────────────────────────
model TelegramUser {
  id            Int      @id @default(autoincrement())
  telegramId    BigInt   @unique @map("telegram_id")
  walletAddress String   @map("wallet_address") @db.VarChar(42)
  encryptedKey  String   @map("encrypted_key") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  settings      Json     @default("{}")

  @@map("telegram_users")
}

// ──────────────────────────────────────────────
// Capital Pool ledger — tracks all inflows/outflows
// ──────────────────────────────────────────────
model PoolLedger {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(30) // 'fee_claim', 'position_open', 'position_close', 'profit_recycle', 'creator_payout', 'burn', 'insurance_deposit', 'insurance_withdrawal'
  amount      BigInt                   // wei (+inflow, -outflow)
  referenceId Int?     @map("reference_id")
  txHash String?  @map("tx_hash") @db.VarChar(66)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@map("pool_ledger")
}

// ──────────────────────────────────────────────
// Insurance Fund — covers edge case losses from slippage
// ──────────────────────────────────────────────
model InsuranceFund {
  id            Int      @id @default(autoincrement())
  type          String   @db.VarChar(20) // 'deposit', 'withdrawal'
  amount        BigInt                   // wei
  reason        String?  @db.VarChar(200)
  txHash   String?  @map("tx_hash") @db.VarChar(66)
  positionId    Int?     @map("position_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([type])
  @@map("insurance_fund")
}
