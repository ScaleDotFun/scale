# LOADED — production environment (Railway)
# Copy to .env and fill in. Never commit a real .env.

# ── Database / cache ──────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/loaded?schema=public"
REDIS_URL="redis://user:pass@host:6379"

# ── Robinhood Chain (EVM, chain id 4663) ──────────────────────
EVM_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
EVM_CHAIN_ID="4663"

# Protocol pool wallet — 0x-prefixed 32-byte EVM private key.
# Generate one locally; never reuse a key that has touched another chain.
PROTOCOL_WALLET_PRIVATE_KEY="0xyour-64-hex-char-private-key"
# Public address of the pool wallet (used when the key is not installed)
PROTOCOL_WALLET=""

# ── Swap routing (LI.FI aggregator) ───────────────────────────
# Defaults to the public endpoint; set a key only for higher rate limits.
LIFI_API_URL=""
LIFI_API_KEY=""

# ── Protocol token ────────────────────────────────────────────
# $LOADED ERC-20 address. Leave EMPTY until the token launches —
# a wrong value makes the burn engine buy and burn the wrong token.
LOADED_TOKEN_MINT=""
# Wallets whose $LOADED is treated as locked (comma-separated)
LOADED_LOCKED_WALLETS=""

# ── Listing gate (PONS) ───────────────────────────────────────
# Required share of PONS creator fees routed to the pool, in percent.
LOADED_MIN_FEE_SHARE_PCT="100"
# Block window scanned when verifying creator-fee receipts.
# Token addresses always allowed to list, bypassing verification (comma-separated)
LOADED_VERIFIED_TOKENS=""

# ── Security ──────────────────────────────────────────────────
# 32 bytes as 64 hex chars — encrypts custodial private keys at rest.
ENCRYPTION_KEY="your-64-hex-char-key"
JWT_SECRET="your-jwt-secret"
ADMIN_SECRET="your-admin-secret"

# ── API / web ─────────────────────────────────────────────────
API_PORT="4001"
CORS_ORIGIN="https://loaded.fun"
FRONTEND_URL="https://loaded.fun"
NODE_ENV="production"
LOG_LEVEL="info"

# ── Optional integrations ─────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://api.loaded.fun/api/auth/google/callback"
TELEGRAM_BOT_TOKEN=""
COINGECKO_API_KEY=""
SENTRY_DSN=""

# ── Economics ─────────────────────────────────────────────────
# Burn batch threshold in wei (0.05 ETH)
BURN_THRESHOLD_WEI="50000000000000000"
