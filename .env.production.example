# ──────────────────────────────────────────────
# SCALE PROTOCOL — Production Environment
# ──────────────────────────────────────────────
# Copy this to .env on your production server.
# All values below MUST be changed before deploying.

# ── Database ──
DATABASE_URL="postgresql://scaleuser:CHANGE_THIS_PASSWORD@postgres:5432/scaleprotocol?schema=public&connection_limit=20"

# ── Redis ──
REDIS_URL="redis://redis:6379"

# ── Solana ──
# REQUIRED in production: a dedicated RPC (Helius/Triton/QuickNode) — the
# public mainnet RPC rate-limits hard under trading load
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# REQUIRED: base58 secret key (or solana-keygen JSON array) for the protocol pool wallet
PROTOCOL_WALLET_PRIVATE_KEY="CHANGE_THIS"
# Public address of the pool wallet
PROTOCOL_WALLET=""
# $SCALE SPL mint — set after the pump.fun launch
SCALE_TOKEN_MINT=""
# Wallets whose $SCALE holdings count as locked supply (comma-separated)
SCALE_LOCKED_WALLETS=""
# Extra token mints always allowed to list, bypassing pump.fun verification (comma-separated)
SCALE_VERIFIED_TOKENS=""
# Optional dedicated wallet that receives manually-claimed pump.fun creator fees
FEE_WALLET=""
# Jupiter API — defaults to the free lite tier; set both for the paid tier
JUPITER_API_URL=""
JUPITER_API_KEY=""
# Paid CoinGecko API key — flips market data to pro-api.coingecko.com (~500 req/min)
COINGECKO_API_KEY=""

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=""

# ── API Server ──
PORT=4001
NODE_ENV=production
# REQUIRED: Generate with `openssl rand -base64 64`
JWT_SECRET="CHANGE_THIS"
# CORS: comma-separated list of allowed origins
CORS_ORIGIN="https://www.scale.fun,https://scale.fun"

# ── Sybil resistance ──
SIGNUP_MAX_PER_DEVICE=1
SIGNUP_MAX_PER_IP=3

# ── Encryption ──
# REQUIRED: Generate with `openssl rand -hex 32`
ENCRYPTION_KEY="CHANGE_THIS"

# ── Protocol Config (basis points) ──
FLAT_FEE_BONDED=200
FLAT_FEE_RISING=300
FLAT_FEE_DEGEN=500
CREATOR_REVENUE_SHARE=3000
BURN_REVENUE_SHARE=2000
POOL_REVENUE_SHARE=5000
USER_PROFIT_LOCK_BPS=3000
# Burn batch threshold in lamports (0.5 SOL)
BURN_THRESHOLD_LAMPORTS=500000000

# ── Insurance Fund ──
INSURANCE_FUND_TARGET_BPS=200
INSURANCE_DEPOSIT_RATE_BPS=1000

# ── Docker Compose ──
POSTGRES_PASSWORD="CHANGE_THIS"
